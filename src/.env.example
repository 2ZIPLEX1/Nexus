# ===========================================
# Steam Trading Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Steam Account ---
STEAM_USERNAME=your_username
STEAM_PASSWORD=your_password
STEAM_API_KEY=your_api_key_from_steamcommunity.com/dev/apikey

# --- Steam Guard Secrets ---
# Get these from your Steam Guard authenticator (maFile or SDA)
STEAM_SHARED_SECRET=your_shared_secret_base64
STEAM_IDENTITY_SECRET=your_identity_secret_base64

# --- Market.CSGO.COM API ---
# Get your API key from https://market.csgo.com/docs-v2
CSGOTM_API_KEY=your_market_csgo_api_key

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Database Paths ---
BOTTM_DB_PATH=./data/main.db
TRADES_DB_PATH=./data/my_trades.db

# --- Trading Settings ---
# Minimum profit percentage to consider buying (e.g., 15 = 15%)
MIN_PROFIT_PERCENT=15

# Maximum price for a single item in USD
MAX_ITEM_PRICE=50.0

# Minimum price for a single item in USD
MIN_ITEM_PRICE=0.5

# Order limit multiplier (x5 means orders can be 5x balance)
ORDER_LIMIT_MULTIPLIER=5

# How often to check for new items to buy (in hours)
BUY_CHECK_INTERVAL_HOURS=2

# How often to check for items to sell (in hours)
SELL_CHECK_INTERVAL_HOURS=1

# Price change threshold for order cancellation (e.g., 10 = 10%)
PRICE_CHANGE_THRESHOLD=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
